server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    location /static/ {
        alias /usr/share/nginx/html/;
    }

    # Variable proxy_pass re-resolves Docker DNS. Recreating web-api gives it a
    # new IP; a static proxy_pass keeps the old address and /api/options 502s.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $tradingagents_web_api ${WEB_API_UPSTREAM};
    location /api/ {
        proxy_pass http://$tradingagents_web_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        gzip off;
    }

    location / {
        try_files $uri /index.html;
    }
}
